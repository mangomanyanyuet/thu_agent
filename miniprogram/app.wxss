/* 全局样式：温和、低刺激的配色，适合心理健康场景 */
page {
  --bg: #f7f5f2;
  --card: #ffffff;
  --ink: #2f2c29;
  --ink-2: #6b665f;
  --ink-3: #9a938b;
  --line: #ece7e1;
  --brand: #6b8e7f;
  --brand-soft: #e8f0ec;
  --warn: #d99a4e;
  --warn-soft: #fbf0e0;
  --danger: #c2604f;
  --danger-soft: #fbeae7;

  background: var(--bg);
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(47, 44, 41, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--ink-3);
  font-size: 26rpx;
}

.body-text {
  color: var(--ink-2);
  font-size: 28rpx;
}

.btn {
  border-radius: 44rpx;
  font-size: 30rpx;
  padding: 0 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--brand);
  color: #fff;
}

.btn-ghost {
  background: var(--brand-soft);
  color: var(--brand);
}

.btn-danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.btn-block {
  width: 100%;
  display: block;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 1.6;
}

.tag-none { background: var(--brand-soft); color: var(--brand); }
.tag-low { background: #eef1f6; color: #6b7a90; }
.tag-moderate { background: var(--warn-soft); color: var(--warn); }
.tag-high { background: var(--danger-soft); color: var(--danger); }
.tag-imminent { background: var(--danger); color: #fff; }
