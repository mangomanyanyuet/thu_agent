.chart-block {
  margin-top: 24rpx;
}

.chart-name {
  font-size: 28rpx;
  font-weight: 600;
}

.chart {
  width: 100%;
  height: 220rpx;
  margin-top: 8rpx;
}

.chart-foot {
  text-align: right;
}

.flag {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.flag-ev {
  margin-top: 10rpx;
  font-size: 27rpx;
  line-height: 1.55;
  color: var(--ink-2);
}

.record {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line);
}

.record-date {
  font-weight: 600;
}

.record-text {
  margin-top: 8rpx;
  font-size: 27rpx;
  line-height: 1.55;
}

.hotline-line {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid var(--line);
  font-size: 28rpx;
}

.hotline-num {
  color: var(--danger);
  font-weight: 600;
}

.m-t {
  margin-top: 20rpx;
}
